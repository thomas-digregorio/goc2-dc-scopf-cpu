{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomas-digregorio/goc2-dc-scopf-cpu/schemas/primary-checkpoint.schema.json",
  "title": "GOC2 derived DC-SCOPF primary checkpoint",
  "type": "object",
  "required": [
    "checkpoint_version",
    "status",
    "profile",
    "qualification",
    "source",
    "reproducibility",
    "run",
    "solver",
    "objectives",
    "timings_seconds",
    "model",
    "artifact",
    "checker"
  ],
  "properties": {
    "checkpoint_version": {"const": 1},
    "status": {"enum": ["primary_solved", "primary_verified", "failed_acceptance"]},
    "profile": {"const": "GOC2-DC-D1-CORRECTIVE-v2"},
    "run": {
      "type": "object",
      "required": ["cold_start", "initial_solution"],
      "properties": {
        "cold_start": {"const": true},
        "initial_solution": {
          "enum": ["none", "internally_generated_from_source"]
        }
      },
      "additionalProperties": false
    },
    "solver": {
      "type": "object",
      "required": ["name", "version", "configuration", "primary"],
      "not": {"required": ["secondary"]},
      "additionalProperties": true
    },
    "objectives": {
      "type": "object",
      "required": ["primary_usd", "primary_dual_bound_usd", "primary_mip_gap"],
      "properties": {
        "primary_usd": {"type": "number"},
        "primary_dual_bound_usd": {"type": "number"},
        "primary_mip_gap": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "checker": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["pending", "pass", "fail"]}},
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
